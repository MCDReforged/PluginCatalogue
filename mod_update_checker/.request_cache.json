      "meta": {
        "schema_version": 4,
        "id": "mod_update_checker",
        "name": "Mod Update Checker",
        "version": "1.6.0",
        "link": "https://github.com/LifeSci-Craft/MCDR-ModUpdateChecker",
        "authors": [
          "Pau1am"
        ],
        "dependencies": {
          "mcdreforged": ">=2.13.0"
        },
        "requirements": [],
        "description": {
          "en_us": "Compare every jar in the server's mods folder against Modrinth, and tell the admin which ones have a newer build. Fabric has no native way to notice an outdated mod; this does. Exclude the mods you never want checked.",
          "zh_cn": "把服务端 mods 目录里的每个 jar 与 Modrinth 上的版本逐一比对，告诉管理员哪些 Mod 有新版本。Fabric 服务端本身没有任何办法发现 Mod 过期，这个插件补上这一环。自己写或不想更新的 Mod 可以排除。"
        }
      },
